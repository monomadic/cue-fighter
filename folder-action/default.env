# Where the tools live.
CUE_FIGHTER_REPO="$HOME/src/cue-fighter"
# CUE_FIGHTER_BIN="$HOME/.cargo/bin/cue-fighter"

# Detection knobs. -s is sensitivity, -r is peak spacing in candidate count
# (NOT time or beats — musical spacing is --min-gap-beats).
CUE_FIGHTER_SENSITIVITY=0.7
CUE_FIGHTER_RADIUS=16
CUE_FIGHTER_MAX_CUES=16
CUE_FIGHTER_SNAP=beat
CUE_FIGHTER_MIN_GAP_BEATS=4

# Cued copies land here; originals are never touched. Point Lexicon (or VDJ) at
# this folder — VirtualDJ only fills EMPTY pads from tags, so it must import the
# copy, not the original. Set to "" to write into the file in place instead.
CUE_FIGHTER_OUT_DIR="$HOME/Music/cue-fighter"

# Snapshot existing cues to <file>.cuebak before writing (cue-fighter undo).
CUE_FIGHTER_BACKUP=1

# Leave files that already carry cues alone.
CUE_FIGHTER_SKIP_EXISTING=1

# Keep the .cues.json next to nothing in particular, for later inspection.
CUE_FIGHTER_KEEP_JSON=1
CUE_FIGHTER_JSON_DIR="$HOME/.local/state/cue-fighter/cues"

# macOS notification per file.
CUE_FIGHTER_NOTIFY=1
